{
  "name": "dm-engine",
  "version": "0.1.0",
  "description": "AI Dungeon Master engine: deterministic 5e rules core with a single tool-using DM agent",
  "type": "module",
  "scripts": {
    "play": "tsx src/cli.ts",
    "seed": "tsx src/fixture/seed.ts",
    "serve": "tsx src/server/index.ts",
    "ingest": "tsx src/content/ingest.ts",
    "models:check": "tsx src/llm/check.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/server/index.ts"
  },
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
