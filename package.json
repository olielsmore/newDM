{
  "name": "dm-engine",
  "version": "0.1.0",
  "description": "AI Dungeon Master engine: deterministic 5e rules core with a single tool-using DM agent",
  "type": "module",
  "scripts": {
    "play": "tsx src/cli.ts",
    "seed": "tsx src/fixture/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
